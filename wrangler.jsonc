{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tagro-echo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CF_ACCOUNT_ID": "c92a3d52fdc33021f324d9c2b05a6ac9",
    "CF_AIG_GATEWAY_ID": "tagro-echo-ai",
    "AI_MODEL": "claude-sonnet-4-6"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
